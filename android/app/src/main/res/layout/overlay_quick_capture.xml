<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/quick_capture_card"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick capture"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/quick_capture_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#000000"
            android:hint="write something about it…"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:minLines="2"
            android:maxLines="4"
            android:padding="12dp"
            android:inputType="textMultiLine|textCapSentences" />

        <LinearLayout
            android:id="@+id/quick_capture_chip_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/quick_capture_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:padding="10dp"
                android:text="Cancel"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/quick_capture_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8622C"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Save"
                android:textColor="#000000"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
